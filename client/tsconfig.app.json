{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.svelte"],
  "exclude": ["src/**/__tests__/*", "src/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
