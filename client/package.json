{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name scaffold --force vite",
    "build": "vite build",
    "preview": "portless scaffold-preview vite preview",
    "preview:test": "vite preview --port 4173",
    "lint": "oxlint --fix && oxfmt && svelte-check --tsconfig ./tsconfig.app.json && svelte-check --tsconfig ./tsconfig.test.json && tsc --noEmit -p ./tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "ky": "^2.2.0",
    "mixpanel-browser": "^2.84.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
